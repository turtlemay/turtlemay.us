---
import "@fontsource/roboto/latin.css";
import "@fontsource/roboto/latin-italic.css";
import "../styles/global.css";

interface Props {
	metaTitle: string;
	metaDescription: string;
}
---
<meta charset="utf-8" />
<meta name="title" content={Astro.props.metaTitle} />
<meta name="description" content={Astro.props.metaDescription} />
<meta name="generator" content={Astro.generator} />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>亀</text></svg>" />
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<link rel="alternate" type="application/rss+xml" title={Astro.props.metaTitle} href={new URL("rss.xml", Astro.site)} />
<link rel="me" href="https://github.com/turtlemay" />
<title>{Astro.props.metaTitle}</title>