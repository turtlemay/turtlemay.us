---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

interface Props {
	id: string;
}

const entry = await getEntry("games", Astro.props.id);

if (!entry) {
	throw new Error(`Entry "${Astro.props.id}" not found.`);
}

const { data: d } = entry;
---
<aside class="gameCallout" aria-description={`${d.title} game info`}>
	<div aria-hidden="true">
	<a href={d.url}>
			<div class="cover">
				<Image
					src={d.cover} width={150}
					alt={`Game cover of ${d.title}, by ${d.author}`}
					title={`${d.title}, by ${d.author}`}
				/>
			</div>
		</a>
	</div>
	<div>
		<div class="gameInfo">
			<div>
				<span class="title">{d.title}</span>
				<span class="year">{d.year}</span>
			</div>
			<div class="author">{d.author}</div>
		</div>
		<div class="description">{d.description}</div>
	</div>
</aside>

<style>
.gameCallout {
	padding: 2em;
	box-sizing: border-box;
	display: flex;
	flex-wrap: wrap;
	max-width: 600px;
	column-gap: 2em;
	row-gap: 1em;
	background: #f5f5f5;
	& > *:last-child {
		flex: 1;
		min-width: 300px;
	}
}

.gameInfo > *:first-child {
	display: flex;
	gap: 5px;
}

.title {
	font-weight: bold;
	font-style: italic;
	font-size: 20px;
	color: #000;
}

.year {
	font-size: 18px;
	font-weight: 300;
	color: #999;
	&::before {
		content: "(";
	}
	&::after {
		content: ")";
	}
}

.author {
	font-size: 16px;
	color: #999;
}

.description {
	font-size: 16px;
	color: #666;
}

.gameInfo::after {
	content: "";
	display: block;
	border-bottom: 3px solid #eee;
	width: 40%;
	margin: 0.5em 0 1em;
}

.gameCallout img {
	width: 150px;
	height: auto;
}

.gameCallout a {
	transition-duration: 300ms;
	transition-property: filter;
	&:hover {
		border: 0;
		filter: initial;
	}
	&:active {
		filter: brightness(0.9);
	}
}
</style>