---
interface Props {
	url: string;
}
---
<aside class="post-callout">
	<h3 class="heading">Original Post</h3>
	<div class="columns">
		<p>
			The following content is adapted from the original post published on my
			<a href={Astro.props.url} rel="nofollow">teletext site</a>.
		</p>
		<p>
			Visit <code class="url">tm.trtl.in</code>
			from your terminal or browser for more of my drafts and status updates.
		</p>
	</div>
</aside>

<style>
	.post-callout {
		padding: 1em 2em;
		margin: 1em 0 2em;
		background: #f9f9f9;
		color: #666;
		border: 6px solid #f5f5f5;
		border-left: 0;
		border-right: 0;
		font-family: "Roboto";
		font-style: normal;
		font-size: inherit;
		line-height: 1.5em;
	}

	.heading {
		color: #222;
		font-weight: bold;
		margin: 0 0 0.5em;
		&::before {
			content: "🔶";
			filter: grayscale(1);
			margin-right: 0.25em;
		}
	}

	.url {
		padding: 0;
		margin: 0 0.1em;
		font-family: monospace;
		background: transparent;
		color: #000;
		border: 0;
	}

	@media (width > 800px) {
		.columns {
			--gap: 1.5em;
			display: flex;
			gap: var(--gap);
		}

		.columns > :last-child {
			border-left: 1px solid #e0e0e0;
			padding-left: var(--gap);
			max-width: 400px;
		}
	}
</style>