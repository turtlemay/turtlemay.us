---
import { Image } from "astro:assets";
import { getPhotos, createPhotoTipText } from "../photos";

const photos = await getPhotos();
const recentPhotos = photos.toReversed().slice(0, 8);
---
<ul class="recentPhotos">
	{recentPhotos.map(v => (
		<li>
			<a class="item" href={`${v.href}#photo`}>
				<div class="image-container">
					<Image src={v.image} alt={createPhotoTipText(v)} title={createPhotoTipText(v)} width={300} />
				</div>
			</a>
		</li>
	))}
</ul>

<style>
.recentPhotos {
	margin: 1em 0;
}

.link {
	display: inline-block;
}

a {
	display: inline-block;
	color: inherit;
	text-decoration: inherit;
	transition-duration: 200ms;
	transition-property: filter;

	&:hover {
		filter: opacity(0.9);
	}

	&:active {
		filter: opacity(1) brightness(0.95);
	}
}

ul, li {
	list-style-type: none;
	margin: 0;
	padding: 0;
}

ul {
	display: grid;
	justify-content: space-between;
	gap: 10px;

	@media (width < 700px) {
		grid-template-columns: auto auto auto;

		li:nth-of-type(6) ~ li {
			display: none;
		}
	}

	@media (width >= 700px) {
		grid-template-columns: auto auto auto auto;
	}
}

.item {
	box-sizing: border-box;
	padding: 5px;
	border: 1px solid #eee;
	aspect-ratio: 1;
	display: flex;
	align-items: center;
	justify-content: center;
}

.image-container {
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}

img {
	object-fit: cover;
	width: 100%;
	height: 100%;
}
</style>