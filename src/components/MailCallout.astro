---
interface Props {
	address: string;
}
---
<div class="mailCallout">
	<div class="envelope">
		<div class="return-abstract" />
		<div class="stamp-abstract" />
		<address class="address">
			{Astro.props.address}
		</address>
	</div>
</div>

<style>
.mailCallout {
	text-align: center;
	max-width: 100vw;
}

.envelope {
	position: relative;
	display: inline-block;
	box-sizing: border-box;
	border: 1px solid #ddd;
	border-left: 0;
	border-right: 0;
	padding: 60px 40px;
	max-width: 400px;
	@media (width > 500px) {
		padding: 60px;
	}
}

.envelope .return-abstract {
	position: absolute;
	left: 10px;
	top: 10px;
	background: #f5f5f5;
	border-radius: 5px;
	width: 50px;
	height: 5px;
}

.envelope .stamp-abstract {
	position: absolute;
	right: 10px;
	top: 10px;
	width: 35px;
	height: 35px;
	display: flex;
	align-items: center;
	justify-content: center;
	font: 35px monospace;
	opacity: 0.5;
	&::after {
		content: "💮";
	}
}

.envelope .address {
	font: italic 12px monospace;
	text-transform: uppercase;
	text-align: left;
	letter-spacing: 0.5px;
	color: #666;
	overflow-x: auto;
	white-space: pre-line;
	padding: 1em 0;
}
</style>