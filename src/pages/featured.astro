---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Blog from "../layouts/Blog.astro";
import SiteLinkCallout from "../components/SiteLinkCallout.astro";

const items = await getCollection("posts", v => {
	return import.meta.env.PROD ? v.data.draft !== true : true;
});

const featuredItems = (items
	.filter(v => v.data.tags?.includes("featured"))
	.sort((a, b) => {
		return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	})
);

function getPostDate(v: (typeof items)[0]) {
	const d = v.data.pubDate;
	return {
		day: d.toLocaleDateString("en-us", { day: "numeric" }),
		month: d.toLocaleDateString("en-us", { month: "short" }),
		year: d.toLocaleDateString("en-us", { year: "numeric" }),
	};
}
---
<Blog blogNavId="featured-posts">
	<Fragment slot={featuredItems.length > 0 && "content"}>
		<main data-pagefind-body>
			<h1 hidden>Featured Posts</h1>
			<ul data-pagefind-ignore>
				{featuredItems.map(v => (
					<li>
						<div class="itemBackground" aria-hidden="true">
							{v.data.coverImage && (
								<Image src={v.data.coverImage} alt="" width={400} />
							)}
						</div>
						<div class="itemContent">
							<div class="postDetails">
								<h2 class="postTitle">{v.data.title}</h2>
								<p class="postDescription">{v.data.description}</p>
								<a class="readMore" href={`/posts/${v.slug}`}>
									Read More
								</a>
							</div>
							<div class="postDate">
								{[getPostDate(v)].map(vv => (
									<span class="day">{vv.day}</span>
									<span class="month">{vv.month}</span>
									<span class="year">{vv.year}</span>
								))}
							</div>
						</div>
					</li>
				))}
				<li class="spacer" />
				<li class="spacer" />
			</ul>
		</main>
		<footer class="endCallout">
			<SiteLinkCallout text="Other posts" href="/posts" />
		</footer>
	</Fragment>
</Blog>

<style>
ul, li {
	list-style-type: none;
	margin: 0;
	padding: 0;
}

ul {
	display: flex;
	align-items: flex-start;
	justify-content: center;
	flex-wrap: wrap;
	column-gap: 20px;
	row-gap: 50px;
	margin-top: 4rem;
}

li {
	position: relative;
	display: inline-flex;
	background-color: #333;
	border-radius: 5px;
	width: 100%;
	max-width: 350px;
	box-sizing: border-box;
	overflow: hidden;
	& > .itemBackground {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
	}
	& > .itemContent {
		position: relative;
		flex: 1;
	}
}

li.spacer {
	visibility: hidden;
	pointer-events: none;
	height: 0;
}

li .itemBackground {
	display: flex;
	align-items: center;
	justify-content: center;
	& > img {
		filter: brightness(0.25) blur(5px);
		min-height: 100%;
		width: auto;
	}
}

li .itemContent {
	display: inline-flex;
	align-items: flex-start;
	color: #fff;
	& > *:first-child {
		flex: 1;
	}
	& > *:last-child {
		margin-right: 10px;
	}
}

li .postTitle {
	margin-top: 0;
}

li .postDate {
	font: 16px "Roboto";
	background: #fff;
	color: #333;
	border-top: 1px solid #ddd;
	border-radius: 0 0 5px 5px;
	text-align: center;
	text-transform: uppercase;
	padding: 5px;
	&::after {
		content: "🗓️";
		display: inline-block;
		padding: 2px 0;
		filter: grayscale(1);
	}
	& > * {
		display: block;
	}
	& .day {
		font-size: 24px;
	}
	& .month {
		&::before, &::after {
			content: "–";
			color: #ddd;
		}
		&::before {
			margin-right: 2px;
		}
		&::after {
			margin-left: 2px;
		}
	}
	& .year {
		font-size: 14px;
	}
}

li .postDetails {
	padding: 1em;
}

li .postTitle {
	font: bold 16px "Roboto";
}

li .postDescription {
	font: 14px "Roboto";
	color: #f5f5f5;
	text-overflow: ellipsis;
	margin-bottom: 120px;
}

li a.readMore {
	display: inline-block;
	text-decoration: none;
	background: #fff;
	border-radius: 5px;
	color: #333;
	padding: 10px 20px;
	font: 12px "Roboto";
	text-transform: uppercase;
	letter-spacing: 1px;
	transition-duration: 200ms;
	transition-property: filter, transform;
	&::after {
		content: "→";
		margin-left: 2px;
	}
	&:hover {
		filter: contrast(0.8);
	}
	&:active {
		transform: scale(0.97);
	}
}

.endCallout {
	margin: 80px 0;
}
</style>