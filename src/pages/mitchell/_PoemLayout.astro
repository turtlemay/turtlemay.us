---
import BaseHead from "./_BaseHead.astro";
import Nav from "./_Nav.astro";
import Memorial from "./_Memorial.astro";
import "./global.css";
import "./poem.css";

interface Props {
	content: {
		title: string;
		description?: string;
		id: string;
	};
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead />
		<meta name="title" content={Astro.props.content.title} />
		<meta name="description" content={Astro.props.content.description || ""} />
		<title>{Astro.props.content.title}</title>
	</head>

	<body class="site-layout">
		<main data-pagefind-body>
			<slot />
		</main>
		<header>
			<Nav active={Astro.props.content.id} />
		</header>
		<footer data-pagefind-body>
			<Memorial />
		</footer>
	</body>
</html>