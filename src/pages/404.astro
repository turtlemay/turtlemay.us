---
import BaseHead from "../components/BaseHead.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteLinkCallout from "../components/SiteLinkCallout.astro";
import { SITE_TITLE } from "../global";

import "../styles/sitePage.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta name="robots" content="noindex" />
		<BaseHead metaTitle={`${SITE_TITLE} - 404 Error`} metaDescription="Page not found" />
		<style>
			main > section:first-of-type {
				margin: 8rem 0;
			}

			.postcard {
				display: flex;
				justify-content: center;
			}
			
			.postcard__card {
				position: relative;
				border: 1px solid #ddd;
				border-left: 0;
				border-right: 0;
				display: flex;
				align-items: flex-start;
				justify-content: center;
				gap: 20px;
				width: 100%;
				max-width: 400px;
				transform: rotate(-2deg);
			}

			.postcard__card > .left {
				padding: 60px 20px;
			}

			.postcard__card > .right {
				border-left: 1px dashed #ddd;
				display: flex;
				align-items: flex-end;
				height: 100%;
			}

			.postcard .stamp-abstract {
				position: absolute;
				right: 10px;
				top: 10px;
				width: 35px;
				height: 35px;
				display: flex;
				align-items: center;
				justify-content: center;
				&::after {
					content: "💮";
					font: 35px monospace;
					opacity: 0.5;
				}
			}

			.postcard .return-abstract {
				position: absolute;
				left: 10px;
				top: 10px;
				background: #f5f5f5;
				border-radius: 5px;
				width: 80px;
				height: 5px;
			}

			.postcard .address-abstract {
				display: flex;
				flex-direction: column;
				gap: 5px;
				margin: 30px;
				& > .abstract-line {
					border: 3px solid #f5f5f5;
					border-radius: 5px;
					:nth-child(1 of &) {
						width: 80px;
					}
					:nth-child(2 of &) {
						width: 120px;
					}
					:nth-child(3 of &) {
						width: 100px;
					}
					:nth-child(4 of &) {
						width: 50px;
					}
				}
			}

			.postcard .text {
				text-align: center;
			}

			.postcard .text > section:not(:last-of-type) {
				margin: 0 0 30px;
			}

			.postcard .text .greetings {
				font: 12px "Roboto";
				text-transform: uppercase;
				letter-spacing: 1px;
				color: #999;
			}

			.postcard .text h1 {
				font: 500 25px "Roboto";
				color: #000;
				margin: 0;
				& > *:first-child {
					font-style: italic;
					font-weight: 300;
					margin: 0 5px 0 0;
				}
			}

			.postcard .text p {
				font: italic 12px "Roboto";
				color: #aaa;
				margin: 0;
			}

			.postcard .text .dingbat {
				font: 1em monospace;
				color: #aaa;
				user-select: none;
			}
		</style>
	</head>
	<body>
		<SiteLayout>
			<main class="sitePage">
				<section>
					<div class="postcard">
						<div class="postcard__card">
							<div class="return-abstract" />
							<div class="stamp-abstract" />
							<div class="left text">
								<section>
									<div class="greetings" aria-hidden="true">Greetings from</div>
									<h1 aria-label="404 Error - Page Not Found">
										<span>Error</span>
										<span>404</span>
									</h1>
								</section>
								<section>
									<p>There's nothing here.</p>
									<div class="dingbat" aria-hidden="true">𐫱</div>
								</section>
							</div>
							<div class="right">
								<div class="address-abstract">
									<div class="abstract-line" />
									<div class="abstract-line" />
									<div class="abstract-line" />
									<div class="abstract-line" />
								</div>
							</div>
						</div>
					</div>
				</section>
				<section>
					<SiteLinkCallout />
				</section>
			</main>
		</SiteLayout>
	</body>
</html>